# Configuração do Banco de Dados
DB_HOST=seu_host_aqui
DB_USER=seu_usuario_aqui
DB_PASS=sua_senha_aqui
DB_NAME=seu_banco_aqui

# Segredo da Aplicação (JWT)
# IMPORTANTE: Gere um segredo aleatório forte usando:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=seu_jwt_secret_aqui_64_caracteres_aleatorios

# Tempo de expiração do token JWT (opcional - padrão: 2h)
# Exemplos: 1h, 30m, 7d, 24h
JWT_EXPIRATION=2h

# Configuração do Servidor
PORT=3000
NODE_ENV=development

# Sequelize Alter (APENAS PARA DESENVOLVIMENTO)
# ATENÇÃO: Pode causar perda de dados! Use com cuidado.
# Descomente apenas se souber o que está fazendo:
# SEQUELIZE_ALTER=true

# URL do Frontend (para CORS)
FRONTEND_URL=https://distribuidorvue.onrender.com
# URLs adicionais (opcional - para múltiplos ambientes)
FRONTEND_URL_2=http://localhost:3001
FRONTEND_URL_3=

# Super Admin Global (multi-unidade)
# Usado pelo deploy (scripts/ensure-super-admin.js) para criar/garantir o
# super global. Na 1ª execução cria o usuário; depois apenas garante o papel.
# A senha nunca é registrada em log; troque-a pelo painel após o 1º acesso.
SUPER_ADMIN_MATRICULA=
SUPER_ADMIN_NOME=Administrador
SUPER_ADMIN_SENHA=

# Integração PJe (opcional)
# Chave de criptografia das credenciais PJe salvas no banco (AES-256-GCM).
# OBRIGATÓRIA para usar a tela "Autenticação PJe". Gere com:
# openssl rand -base64 32
PJE_CRED_ENC_KEY=
# As credenciais PJe agora são POR UNIDADE, cadastradas pela tela
# "Autenticação PJe" (criptografadas no banco). O cron importa cada unidade
# com a sua própria credencial.
# Endpoint MNI (opcional - padrão: 1º grau do TJCE)
PJE_MNI_ENDPOINT=
